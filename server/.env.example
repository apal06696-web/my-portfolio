# Copy this file to .env and fill in your SMTP credentials
# For Gmail, you can use smtp.gmail.com and an App Password (not your account password)

PORT=3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password

# Optional: override from/to addresses
FROM_EMAIL=your-sender@example.com
TO_EMAIL=apal06696@gmail.com
